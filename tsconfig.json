{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "apps/api/src/**/*.ts",
    "apps/api/tests/**/*.ts",
    "apps/web/src/**/*.ts",
    "apps/web/tests/**/*.ts"
  ]
}
