{
  "name": "@alekstar79/ykassa-messenger",
  "description": "Standalone Telegram and MAX gateway for the YooKassa MCP integrator.",
  "author": "Aleksey Tarasenko <alekstar79@yandex.ru>",
  "version": "1.1.1",
  "license": "MIT",
  "type": "module",
  "private": false,
  "keywords": [
    "yookassa",
    "mcp",
    "messenger",
    "telegram",
    "max",
    "bot",
    "payments"
  ],
  "homepage": "https://github.com/alekstar79/ykassa-mcp-integrator/tree/main/apps/messenger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alekstar79/ykassa-mcp-integrator.git",
    "directory": "apps/messenger"
  },
  "bugs": {
    "url": "https://github.com/alekstar79/ykassa-mcp-integrator/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/server.js"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@alekstar79/ykassa-contracts": "^1.1.1",
    "dotenv": "^18.0.10",
    "grammy": "^1.48.0",
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
